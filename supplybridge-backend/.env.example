# Port used by the Express server
PORT=5000

# Local MongoDB connection string.
# "supplybridge" is the database name and will be created automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/supplybridge

# Secret used to sign login tokens. Replace this with a long random string.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_your_own_long_random_secret

# How long a login token stays valid
JWT_EXPIRES_IN=7d

NODE_ENV=development
HOST=0.0.0.0
CORS_ORIGINS=
TRUST_PROXY=
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
AUTH_FAILURE_WINDOW_MS=900000
AUTH_FAILURE_LIMIT=20
